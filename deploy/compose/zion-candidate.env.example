# Preparation template only. Deliberately unusable until an operator fills it.
# Use a NEW protected file outside every checkout, not an existing .env.
# No credential generation, old-volume import, public exposure or start is approved.
# Tailscale human verification and source/artifact acceptance are still pending.
# All images need verified repository@sha256:<64 lowercase hex> references.
# Record the actual build source + existing BUZZ_SOURCE_SHA/BUZZ_BUILD_ID seam
# separately; an upstream base SHA alone does not identify a branded dirty build.
ZION_RELAY_IMAGE=
# Must name postgres:17[-variant] and a verified digest, not a mutable tag.
ZION_POSTGRES_IMAGE=
ZION_REDIS_IMAGE=

# New candidate-only operator-supplied values. Use URL-safe DB/Redis passwords
# because upstream interpolates them into connection URLs without encoding.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_RELAY_PRIVATE_KEY=
RELAY_OWNER_PUBKEY=
BUZZ_GIT_HOOK_HMAC_SECRET=

# OPTIONAL gateway-only values; omit compose.zion-gateway.yml by default.
# Before starting it: provision a new DML-only role in its dedicated buzz_push DB
# and apply the upstream --migrate-only/grants flow with admin credentials.
# Apple certs/keyrings must be independently supplied; never reuse old secrets.
# Relay push stays off even if the optional gateway file is included.
# ZION_GATEWAY_IMAGE=
# ZION_PUSH_POSTGRES_PASSWORD=
# ZION_PUSH_RUNTIME_DATABASE_URL=postgres://<new-runtime-role>:<url-safe-password>@push-postgres:5432/buzz_push
# ZION_PUSH_GRANT_KEYS=
# ZION_PUSH_TOKEN_KEYS=
# ZION_PUSH_APP_ID=
# ZION_PUSH_APNS_TOPIC=
# ZION_PUSH_APNS_CERT_FILE=
# ZION_PUSH_ATTEST_ROOT_FILE=
