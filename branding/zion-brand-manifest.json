  "motion": {
    "frameSourcePolicy": "dedicated-frame-or-code-native",
    "variants": [
      "loader",
      "onboarding",
      "liveness",
      "pairing",
      "agent-entrance"
    ],
    "loader": {
      "durationMs": 1800,
      "loop": true,
      "mode": "code-native",
      "reducedMotion": "static"
    },
    "onboarding": {
      "durationMs": 900,
      "settleMs": 2400,
      "loop": false,
      "mode": "code-native",
      "reducedMotion": "settled"
    },
    "liveness": {
      "durationMs": 1400,
      "loop": true,
      "mode": "code-native",
      "reducedMotion": "static"
    },
    "pairing": {
